# shellcheck disable=all
# This file contains chezmoi template syntax which will be processed by chezmoi
{{- if eq .chezmoi.os "darwin" -}}
# MacPorts Installer addition
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
export MANPATH="/opt/local/share/man:$MANPATH"

# Homebrew (cached: `brew shellenv` costs ~0.4s; regenerated when brew itself updates)
_brew_env="${XDG_CACHE_HOME:-$HOME/.cache}/brew-shellenv.zsh"
if [[ ! -s "$_brew_env" || "{{ .brewPrefix }}/bin/brew" -nt "$_brew_env" ]]; then
    mkdir -p "${_brew_env:h}" && "{{ .brewPrefix }}/bin/brew" shellenv zsh >| "$_brew_env"
fi
source "$_brew_env"
unset _brew_env

{{- if .solana -}}
# Solana
export PATH="{{ .chezmoi.homeDir }}/.local/share/solana/install/active_release/bin:$PATH"
{{- end -}}

{{- if .orbstack }}
# Added by OrbStack: command-line tools and integration
source "{{ .chezmoi.homeDir }}/.orbstack/shell/init.zsh" 2>/dev/null || :
{{- end }}

{{- else if eq .chezmoi.os "linux" -}}
# Linux-specific profile settings
export PATH="/usr/local/bin:$PATH"

{{- if .orbstack }}
# Added by OrbStack: command-line tools and integration
source "{{ .chezmoi.homeDir }}/.orbstack/shell/init.zsh" 2>/dev/null || :
{{- end }}
{{- end -}}
